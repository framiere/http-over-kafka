# Public halves of the dev keys in gateway-signing.env and bridge-signing.env.
# Safe for every process. Who reads what:
#   bridge  → KB_TRUSTED_GATEWAY_KEYS (verifies commands)
#   gateway → KB_TRUSTED_BRIDGE_KEYS  (verifies responses)
#   deriver → KB_TRUSTED_BRIDGE_KEYS  (verifies results)
#   audit   → both (marks authenticity of commands and results)
KB_TRUSTED_GATEWAY_KEYS=dev-insecure-gateway-1:agXzz5jTSSowAwheM7Cxk5BR+/vWv6ho670TUHVuFtY=
KB_TRUSTED_BRIDGE_KEYS=dev-insecure-bridge-1:4AIplwBU1mK7EaiFf7HU+cpSfrzR8LhkOMW8HJfQJzc=
