# Gateway caller authentication: which IdP tokens it accepts. Public keys only;
# the matching INSECURE dev private key is in deploy/dev-idp.env, for minting
# tokens on a laptop. A real deployment points these at its IdP's keys.
HOK_JWT_ISSUER=dev-idp
HOK_JWT_AUDIENCE=http-over-kafka
HOK_JWT_KEYS=dev-insecure-idp-1:owzn7BLYNHbVLCuqHk4elGSQ0sF/csq87feytQzkN0E=
